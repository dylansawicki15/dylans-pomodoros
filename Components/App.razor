@using Microsoft.AspNetCore.Components.Routing

@* The one HTML page every component is drawn into. The router reads the URL and puts the matching page component in the body. *@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Personal Life</title>
    @* Without this a phone pretends to be a 980-pixel-wide desktop and shrinks the page to fit, so your xs="12" would never kick in there. *@
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* Blazor's script works out its own addresses (like /_blazor) from this. *@
    <base href="/" />
    @* MudBlazor's look: a stylesheet that ships inside the package. @Assets turns the file name into its real address,
       with a version stamp in it so the browser never keeps an old copy after an update. *@
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
</head>
<body>
    <Router AppAssembly="typeof(Program).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" />
        </Found>
    </Router>
    @* Blazor's JavaScript: opens the live connection and applies the server's changes to the page. *@
    <script src="_framework/blazor.web.js"></script>
    @* MudBlazor's behaviour (popups, click ripples): its script, also inside the package. *@
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>
</html>
