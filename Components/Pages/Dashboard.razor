@page "/dashboard"
@using System.Runtime.InteropServices
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using MudBlazor.Charts
@* The guard, like Angular's canActivate: only your Google account gets the page (the OnlyMe rule in Program.cs). Anyone not signed in is sent to Google. *@
@attribute [Authorize(Policy = "OnlyMe")]
@* Keeps a live connection open between this page and the server, so a click runs your C# without a reload. *@
@rendermode RenderMode.InteractiveServer
@* Gets the stats service from the app's services, the same way PomodoroStatsService's constructor gets FeedDbContext. *@
@inject PomodoroStatsService Stats
@* Same @inject, different service: this one knows who the sign-in cookie says you are. *@
@inject AuthenticationStateProvider Auth

@* MudBlazor's two helpers. Apps usually put them in a shared layout; this one has none, so they sit on the page.
   Like every MudBlazor piece, they only work on a page with the live connection.
   The theme provider writes MudBlazor's colours and fonts into the page; the popover provider is the layer dropdowns and tooltips appear on. *@
<MudThemeProvider />
<MudPopoverProvider />

@* MudContainer is the page's frame, like Bootstrap's .container: it caps the width at 1280 pixels (MaxWidth.Large), centres the page
   and pads its sides, which MudGrid needs (without it, the grid's right edge ran off the window). py-8: 32 pixels above and below. *@
<MudContainer MaxWidth="MaxWidth.Large" Class="py-8">
    @* MudText is MudBlazor's text. Typo picks the style, the way you'd pick h1 or p. Material's h1 is huge, so h4 is the dashboard-sized heading. *@
    <MudText Typo="Typo.h4">Welcome to my very fun and useful dashboard</MudText>

    <MudText Class="mb-6">Signed in as @name (@email) <MudLink Href="/logout">Sign out</MudLink></MudText>

    @* Your Total component, once per period. Label is text, so "Today" is just the word.
       Minutes is a number, so what's in its quotes is C#: the field's name, no @ needed.
       MudGrid lays the cards out in rows 12 columns wide, like Bootstrap's grid. Each MudItem says how many of the 12 its card takes.
       xs and md are window widths: xs counts from a phone up, md from 960 pixels up (a laptop). Below 960 a card takes its xs number, from 960 its md number. *@
    <MudGrid>
        <MudItem xs="12" md="6"><Total Label="Today" Minutes="todayMinutes" /></MudItem>
        <MudItem xs="12" md="6"><Total Label="This week" Minutes="weekMinutes" /></MudItem>
        <MudItem xs="12" md="6"><Total Label="This month" Minutes="monthMinutes" /></MudItem>
        <MudItem xs="12" md="6"><Total Label="This year" Minutes="yearMinutes" /></MudItem>
    </MudGrid>

    @* The pace line: your 7-day average on every day of the last year, so speeding up, holding steady or slipping shows at a glance.
       Timeseries is MudBlazor's line chart for dated points: it spaces them by date and labels the bottom axis with dates. *@
    @if (paceSeries is not null)
    {
        <MudText Typo="Typo.h5" Class="mt-6 mb-4">Your pace</MudText>
        @* In the same flat card as your totals, so the page reads as one set.
           MatchBoundsToSize: the chart draws at the card's real width. Without it, it keeps a fixed shape and 300px tall made it narrow, centred in the middle. *@
        <MudCard Elevation="0" Outlined="true" Class="rounded-lg">
            <MudCardContent>
                <MudChart T="double" ChartType="ChartType.Timeseries" ChartSeries="paceSeries" ChartOptions="paceOptions" Width="100%" Height="300px" MatchBoundsToSize="true" />
            </MudCardContent>
        </MudCard>
    }

    @* Keep this up: your average over the last 7 days, carried forward. PomodoroStatsService already did the maths; the page just shows it. *@
    @if (projection is not null)
    {
        <MudText Typo="Typo.h5" Class="mt-6 mb-4">Keep this up and you'll add</MudText>

        @* The same grid as your totals. Five cards don't make even rows, so the biggest number gets the whole last row (md="12"). *@
        <MudGrid>
            <MudItem xs="12" md="6"><Total Label="In 1 month" Minutes="projection.OneMonthMinutes" /></MudItem>
            <MudItem xs="12" md="6"><Total Label="In 3 months" Minutes="projection.ThreeMonthsMinutes" /></MudItem>
            <MudItem xs="12" md="6"><Total Label="In 6 months" Minutes="projection.SixMonthsMinutes" /></MudItem>
            <MudItem xs="12" md="6"><Total Label="In 1 year" Minutes="projection.OneYearMinutes" /></MudItem>
            <MudItem xs="12" md="12"><Total Label="In 10 years" Minutes="projection.TenYearsMinutes" /></MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private string? name;
    private string? email;

    private int todayMinutes;
    private int weekMinutes;
    private int monthMinutes;
    private int yearMinutes;
    // The ? means "may be null": it stays empty until the stats have loaded.
    private PomodoroProjection? projection;
    // The chart's lines. You have one, the pace line. Like projection, it stays null until the stats have loaded.
    private List<ChartSeries<double>>? paceSeries;

    // How the chart draws. Its defaults are for points minutes apart ("HH:mm" labels), so these show days.
    // The label spacing depends on how long your history is, so OnInitializedAsync sets it.
    private readonly TimeSeriesChartOptions paceOptions = new()
    {
        TimeLabelFormat = "d MMM",                  // the bottom axis reads "19 Sept", "21 Sept", ...
        TooltipTimeLabelFormat = "d MMM",           // ... and so does hovering the line
        YAxisRequireZeroPoint = true,               // the left axis starts at 0, so a dip from 178 to 136 doesn't look like a crash
    };

    // Blazor calls this once, when the page is first built.
    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        name = user.FindFirst(ClaimTypes.Name)?.Value;
        email = user.FindFirst(ClaimTypes.Email)?.Value;

        var stats = await Stats.GetAsync();
        todayMinutes = stats.TodayMinutes;
        weekMinutes = stats.WeekMinutes;
        monthMinutes = stats.MonthMinutes;
        yearMinutes = stats.YearMinutes;

        projection = stats.Projection;

        // The pace line from your first pomodoro day on. Before that it's months of zeros that squeeze your real line into a corner.
        // SkipWhile drops points from the front while its test is true, then keeps everything after, so a day off once you've started stays on the line.
        var paceSinceStart = stats.PaceLine
            // TODO(you): the test that's true for every point before your first pomodoro day.
            .SkipWhile(p => p.MinutesPerDay == 0)
            .ToList();

        // About 6 date labels along the bottom, however long your history is. Each label is the first date plus n steps,
        // so a fixed 30-day step drifted off the months ("Jul" twice).
        paceOptions.TimeLabelSpacing = TimeSpan.FromDays(Math.Max(1, paceSinceStart.Count / 6));

        // The chart doesn't know your DayPace record. It wants TimeValue points: a DateTime and a number. So each DayPace gets translated.
        // [ ... ] makes a list, like a JS array literal.
        paceSeries =
        [
            new ChartSeries<double>
            {
                Name = "7-day average",
                Data = paceSinceStart
                    .Select(p => new TimeValue<double>(p.Day.ToDateTime(TimeOnly.MinValue), p.MinutesPerDay))
                    .ToArray(),
                TooltipYValueFormat = "0",   // whole minutes when you hover: "11", not "10.714285714"
            },
        ];
    }
}
