@page "/dashboard"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@* The guard, like Angular's canActivate: only your Google account gets the page (the OnlyMe rule in Program.cs). Anyone not signed in is sent to Google. *@
@attribute [Authorize(Policy = "OnlyMe")]
@* Keeps a live connection open between this page and the server, so a click runs your C# without a reload. *@
@rendermode RenderMode.InteractiveServer
@* Gets the stats service from the app's services, the same way PomodoroStatsService's constructor gets FeedDbContext. *@
@inject PomodoroStatsService Stats
@* Same @inject, different service: this one knows who the sign-in cookie says you are. *@
@inject AuthenticationStateProvider Auth

@* MudBlazor's two helpers. Apps usually put them in a shared layout; this one has none, so they sit on the page.
   Like every MudBlazor piece, they only work on a page with the live connection.
   The theme provider writes MudBlazor's colours and fonts into the page; the popover provider is the layer dropdowns and tooltips appear on. *@
<MudThemeProvider />
<MudPopoverProvider />

@* MudText is MudBlazor's text. Typo picks the style, the way you'd pick h1 or p. Material's h1 is huge, so h4 is the dashboard-sized heading. *@
<MudText Typo="Typo.h4">Welcome to my very fun and useful dashboard</MudText>

<MudText>Signed in as @name (@email) <MudLink Href="/logout">Sign out</MudLink></MudText>

@* Variant, Color and OnClick are the button's parameters, its @Input()s.
   OnClick, not @onclick: @onclick is for plain HTML tags, OnClick is MudButton's own. Same result: your method runs on the server, then Blazor redraws. *@
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowToday">Today</MudButton>
<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowWeek">This week</MudButton>
<MudText>@minutes minutes of pomodoros @period</MudText>

@code {
    private string? name;
    private string? email;

    private int todayMinutes;
    private int weekMinutes;

    // What the page shows right now. The buttons change these two.
    private int minutes;
    private string period = "today";

    // Blazor calls this once, when the page is first built.
    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        name = user.FindFirst(ClaimTypes.Name)?.Value;
        email = user.FindFirst(ClaimTypes.Email)?.Value;

        var stats = await Stats.GetAsync();
        todayMinutes = stats.TodayMinutes;
        weekMinutes = stats.WeekMinutes;
        ShowToday();
    }

    private void ShowToday()
    {
        minutes = todayMinutes;
        period = "today";
    }

    private void ShowWeek()
    {
        minutes = weekMinutes;
        period = "week";
    }
}
