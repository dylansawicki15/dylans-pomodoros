@using MudBlazor

@* One total on the dashboard: a label and a time, in a MudBlazor card.
   Your own component, so the dashboard can write <Total Label="Today" Minutes="todayMinutes" /> four times instead of copying the card four times.
   The page's MudGrid spaces the cards now, so the card needs no gap of its own.
   Elevation="0" with Outlined: a thin border instead of a drop shadow, flat like the chart. rounded-lg rounds the corners more.
   The label is an overline (small, spaced-out letters) in mud-text-secondary, MudBlazor's grey, so the number is what you see first. *@
<MudCard Elevation="0" Outlined="true" Class="rounded-lg">
    <MudCardContent>
        <div class="d-flex align-center gap-2 mud-text-secondary">
            <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" />
            <MudText Typo="Typo.overline">@Label</MudText>
        </div>
        <MudText Typo="Typo.h3" Color="Color.Primary">@Format(Minutes)</MudText>
    </MudCardContent>
</MudCard>

@code {
    // [Parameter] lets the page that uses this component set the property, like @Input() in Angular.
    [Parameter] public string Label { get; set; } = "";

    [Parameter] public int Minutes { get; set; } = 0;

    // 25 → "25m", 950 → "15h 50m", 20000 → "13d 21h". From a day up the minutes are dropped: at that size they're noise.
    // static: Format belongs to Total itself, not to one card, so a test can call Total.Format(950) without building a page.
    public static string Format(int minutes)
    {
        var time = TimeSpan.FromMinutes(minutes);

        if (time.TotalHours < 1) return $"{time.Minutes}m";
        if (time.TotalDays < 1) return $"{time.Hours}h {time.Minutes}m";
        return $"{time.Days}d {time.Hours}h";
    }
}
