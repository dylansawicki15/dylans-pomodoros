<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>166e88bb-5d57-44a9-81f2-fd8222394350</UserSecretsId>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;</DefaultItemExcludes>
    <!-- The SDK only adds Blazor's own script (_framework/blazor.web.js) when it can see .razor files. The Dockerfile restores
         with nothing but this file copied in, so it saw none, and the live site shipped without the script: no live connection, so no chart.
         Saying it here means restore no longer depends on which files have been copied yet. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
  </ItemGroup>

  <!-- Tests reach FeedDbContext directly to prove rules the endpoints can no longer break. -->
  <ItemGroup>
    <InternalsVisibleTo Include="PersonalLifeApi.Tests" />
  </ItemGroup>

</Project>
